{
  "name": "browserscope",
  "version": "0.1.0",
  "description": "A local-first, evidence-based browser observability extension.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "prepare:wxt": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm zip:chrome",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm prepare:wxt && pnpm --filter @browserscope/sdk build && tsc -p tsconfig.json --noEmit && pnpm --filter @browserscope/sdk typecheck",
    "test": "pnpm test:unit && pnpm --filter @browserscope/sdk test",
    "test:unit": "pnpm --filter @browserscope/sdk build && vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "pnpm --filter @browserscope/sdk build && vitest run --config vitest.integration.config.ts && pnpm build:chrome && node scripts/verify-extension-output.mjs",
    "test:e2e": "pnpm build:chrome && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "dependencies": {
    "@browserscope/sdk": "workspace:*",
    "@noble/hashes": "2.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wxt": "0.21.2"
  }
}
